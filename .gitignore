# assessment output & subject data — never committed
balise-out/
assessment-*/
evaluation-*/
engagement-*/
mandat-*/

# reference documents (CAI publications) — cited, never redistributed
.refs/
intake/*.yaml
!intake/intake.template.yaml

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# loxodonta activity chains - agent session records, never committed
# (loxodonta also drops a self-ignoring receipts/.gitignore; this is the
# root-level rule, which survives that marker being removed)
receipts/

# env / secrets
.env

# operator files - local only, never public
CLAUDE.md
METACOG.md
